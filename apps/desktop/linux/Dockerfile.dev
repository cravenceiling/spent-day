# The official Rust image, pinned by digest. Its toolchain comes from rustup inside the image,
# so nothing is fetched and piped to a shell here.
FROM rust:1.99.1-slim-trixie@sha256:f938561c139ff3f8b4449fe5064ede0ea526229b0fc8ea58a5031c3bf40e72d3

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config curl ca-certificates git \
      libxkbcommon-dev libwayland-dev libxkbcommon-x11-0 mesa-vulkan-drivers libvulkan1 \
      xvfb xauth openbox xdotool xterm x11-utils imagemagick \
      chromium sway foot xwayland python3 sqlite3 nodejs gjs dbus-x11 dbus-user-session \
      fonts-cantarell fonts-dejavu-core adwaita-icon-theme librsvg2-common librsvg2-bin zip \
    && rm -rf /var/lib/apt/lists/*

# The containers run as root. The Rust image makes its toolchain writable by every user, which
# root does not need. verify.sh and scripts/e2e-cross-device.sh keep the crate registry in a
# volume at /opt/cargo/registry, so cargo looks for it there.
RUN chmod -R go-w "$CARGO_HOME" "$RUSTUP_HOME" && mkdir -m 755 /opt/cargo
ENV CARGO_HOME=/opt/cargo

RUN touch /.spentday-dev
WORKDIR /src
